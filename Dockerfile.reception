# Reception app image (`reception-web`, OpenSpec change `isolate-venue-reception`,
# design D4). Unlike the consumer, admin and organizer images, which share ONE
# `npm run build` of every entry, this image comes from the reception app's own
# build (`vite.reception.config.ts`, output `dist-reception/`). It serves only
# that output: the reception screen, its QR decoder worker and WebAssembly, the
# site icons and its bundled `config.json` (each environment's pod mounts its
# own over it). No console, consumer or OIDC code is in it.

# Stage 1: Build the reception app
FROM node:26-alpine@sha256:c6ad9e9c1d80f6eb607c26b4b0a132ff7a2344fad1c78ea3baa2a7d4c8de6d94 AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# Env-agnostic build: the bundle fetches /config.json at runtime.
RUN npm run build:reception

# Fail the image build when the output contains the OIDC client or console
# code; also prints the output size.
RUN npm run verify:reception-bundle

#----------------------------

# Stage 2: Serve with Caddy
FROM caddy:2-alpine@sha256:de23def33b17fb5d1290b0f6c2add1d70780e52341896c00a4c8a2a2fe9d355e

COPY --from=builder /app/dist-reception /srv
COPY Caddyfile.reception /etc/caddy/Caddyfile

EXPOSE 80
