{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "target": "ES2017",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "importHelpers": true,
    "sourceMap": true,
    "strict": false,
    "types": ["*"],
    "paths": {
      "plain-date-engine": ["./src/lib/plain-date/date-impl.ts"]
    }
  },
  "include": [
    "src",
    "admin",
    "shared"
  ],
  "exclude": [
    "**/*.stories.ts"
  ],
  "files": [
    "src/resource.d.ts"
  ]
}