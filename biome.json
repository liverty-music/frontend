{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"domains": {
			"playwright": "none"
		},
		"rules": {
			"preset": "recommended"
		}
	},
	"overrides": [
		{
			"includes": ["test/**/*.ts", "src/**/*.spec.ts", "e2e/**/*.ts"],
			"linter": {
				"rules": {
					"style": {
						"noNonNullAssertion": "off"
					},
					"suspicious": {
						"noExplicitAny": "off"
					}
				}
			}
		},
		{
			"includes": ["e2e/**"],
			"linter": {
				"domains": {
					"playwright": "recommended"
				},
				"rules": {
					"correctness": {
						"noPlaywrightMissingAwait": "error",
						"usePlaywrightValidDescribeCallback": "error"
					},
					"suspicious": {
						"noPlaywrightForceOption": "error",
						"noPlaywrightNetworkidle": "error",
						"noPlaywrightPagePause": "error",
						"noPlaywrightWaitForNavigation": "error",
						"noPlaywrightWaitForTimeout": "error"
					},
					"complexity": {
						"noPlaywrightUselessAwait": "error"
					},
					"style": {
						"noPlaywrightElementHandle": "error",
						"noPlaywrightEval": "error",
						"noPlaywrightWaitForSelector": "error"
					},
					"performance": {
						"useDomNodeTextContent": "off"
					}
				}
			}
		},
		{
			"includes": [
				"src/components/coach-mark/coach-mark.css",
				"src/components/live-highway/beam-timeline.css"
			],
			"linter": {
				"enabled": false
			},
			"formatter": {
				"enabled": false
			}
		}
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "asNeeded"
		}
	},
	"css": {
		"parser": {
			"cssModules": false
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"html": {
		"linter": {
			"enabled": false
		}
	}
}
